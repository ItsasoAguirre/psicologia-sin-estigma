---
// Reproductor de Spotify "bajo demanda": hasta que la persona pulsa, solo se muestra un botón
// con el estilo de la web. Así la página no descarga ~650 KB de Spotify ni recibe sus cookies
// de terceros sin una acción de quien visita.
import Icono from './Icono.astro';
import { spotify } from '../lib/utilidades.js';

interface Props { url: string; titulo: string; programa: string }
const { url, titulo, programa } = Astro.props;
const embed = spotify(url);
---
{embed ? (
  <div class="sp" data-spotify={`${embed}?autoplay=1`} data-titulo={`${programa}: ${titulo}`}>
    <button type="button" class="sp__boton">
      <span class="sp__play" aria-hidden="true"><Icono nombre="play" size={22} /></span>
      <span class="sp__texto">
        <span class="sp__titulo">{titulo}</span>
        <span class="sp__nota">Escuchar aquí · se cargará el reproductor de Spotify</span>
      </span>
    </button>
    <a class="sp__enlace" href={url} target="_blank" rel="noopener">Abrir en Spotify <Icono nombre="enlace" size={14} /></a>
  </div>
) : (
  <a class="boton boton--borde" href={url} target="_blank" rel="noopener">{titulo} <Icono nombre="enlace" size={18} /></a>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-spotify]').forEach((caja) => {
    caja.querySelector('button')!.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = caja.dataset.spotify!;
      iframe.title = caja.dataset.titulo!;
      iframe.height = '152';
      iframe.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
      iframe.className = 'sp__iframe';
      caja.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .sp { display: grid; gap: .35rem; }
  .sp__boton {
    display: flex; align-items: center; gap: 1rem; width: 100%; min-height: 96px; padding: 1rem 1.25rem;
    border: 0; border-radius: 12px; cursor: pointer; text-align: left; font: inherit;
    background: var(--morado-800); color: #fff; transition: background .2s;
  }
  .sp__boton:hover { background: var(--morado-700); }
  .sp__play { flex: none; width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: #fff; color: var(--morado-800); }
  .sp__play :global(.icono) { margin-left: 3px; fill: currentColor; }
  .sp__texto { display: grid; gap: .15rem; }
  .sp__titulo { font-weight: 700; font-size: 1.1rem; }
  .sp__nota { font-size: .88rem; color: var(--lila-200); }
  .sp__enlace { justify-self: end; font-size: .9rem; display: inline-flex; gap: .3rem; align-items: center; }
  .sp :global(.sp__iframe) { width: 100%; border: 0; border-radius: 12px; }
</style>
