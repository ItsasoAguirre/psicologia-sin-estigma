---
import Icono from './Icono.astro';
interface Props { boton: string; texto: string; cta?: string }
const { boton, texto, cta } = Astro.props;
---
<section class="sesion" aria-labelledby="sesion-titulo">
  <div class="sesion__icono"><Icono nombre="portatil" size={34} /></div>
  <div>
    <h2 id="sesion-titulo" class="sesion__titulo">Sesión informativa gratuita</h2>
    <p>{texto}</p>
    <div class="sesion__acciones">
      <a class="boton" href="/contacto">{boton} <Icono nombre="flecha" size={18} /></a>
    </div>
    {cta && <p class="sesion__cta"><a href="/contacto">{cta}</a></p>}
  </div>
</section>
<style>
  .sesion {
    display: grid; grid-template-columns: auto 1fr; gap: 1.25rem; align-items: start;
    background: var(--verde-50); border: 1px solid var(--verde-200); border-radius: var(--radio-lg);
    padding: clamp(1.25rem, 3vw, 2rem); margin-block: 3rem;
  }
  .sesion__icono { width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; background: var(--verde-600); color: #fff; }
  .sesion__titulo { margin: 0 0 .5rem; font-size: 1.4rem; color: var(--verde-800); }
  .sesion__acciones { margin-top: 1rem; }
  .sesion__cta { margin: 1rem 0 0; font-weight: 700; }
  @media (max-width: 560px) { .sesion { grid-template-columns: 1fr; } }
</style>
