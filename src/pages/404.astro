---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { servicios } from '../lib/datos.js';
---
<Base titulo="Página no encontrada" noindex>
  <section class="seccion">
    <div class="contenedor estrecho no-encontrada">
      <p class="mano no-encontrada__num" aria-hidden="true">404</p>
      <h1>Esta página no existe</h1>
      <p>Puede que la dirección esté mal escrita o que la página haya cambiado de sitio. Estas son las secciones de la web:</p>
      <ul>
        <li><a href="/">Inicio</a></li>
        <li><a href="/sobre-mi">Sobre mí</a></li>
        {servicios.map((s) => <li><a href={s.href}>{s.texto}</a></li>)}
        <li><a href="/recursos">Recursos</a></li>
        <li><a href="/contacto">Contacto</a></li>
      </ul>
      <a class="boton" href="/">Volver al inicio <Icono nombre="flecha" size={18} /></a>
    </div>
  </section>
</Base>
<style>
  .no-encontrada__num { font-size: clamp(4rem, 14vw, 7rem); line-height: 1; margin: 0; }
  .no-encontrada ul { columns: 2; margin-bottom: 2rem; }
  @media (max-width: 480px) { .no-encontrada ul { columns: 1; } }
</style>
