---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Brevo from '../components/Brevo.astro';
import { pagina, ajustes } from '../lib/datos.js';
const p = pagina('contacto');
const tel = ajustes.telefono?.replace(/\s/g, '');
---
<Base titulo={p.titulo}>
  <section class="seccion">
    <div class="contenedor contacto">
      <div>
        <h1>{p.titulo}</h1>
        <p class="intro">{p.intro}</p>
        <ul class="datos">
          <li>
            <span class="datos__ic"><Icono nombre="email" /></span>
            <div><strong>Correo electrónico</strong><a href={`mailto:${ajustes.email}`}>{ajustes.email}</a></div>
          </li>
          {ajustes.telefono && (
            <li>
              <span class="datos__ic"><Icono nombre="telefono" /></span>
              <div><strong>Teléfono</strong><a href={`tel:${tel}`}>{ajustes.telefono}</a><span class="datos__peq">{ajustes.horario}</span></div>
            </li>
          )}
          {ajustes.instagram_url && (
            <li>
              <span class="datos__ic"><Icono nombre="instagram" /></span>
              <div><strong>Redes sociales</strong><a href={ajustes.instagram_url} target="_blank" rel="noopener">{ajustes.instagram_usuario}</a></div>
            </li>
          )}
        </ul>
      </div>
      <div class="formulario">
        <h2>{p.formulario_titulo}</h2>
        <Brevo codigo={ajustes.brevo_contacto} titulo="Formulario de contacto" alto={720} />
      </div>
    </div>
  </section>
</Base>
<style>
  .contacto { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 860px) { .contacto { grid-template-columns: 1fr; } }
  .intro { font-size: 1.15rem; color: var(--texto-suave); }
  .datos { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1.25rem; }
  .datos li { display: flex; gap: 1rem; align-items: flex-start; }
  .datos div { display: flex; flex-direction: column; }
  .datos a { font-size: 1.15rem; font-weight: 700; }
  .datos__ic { flex: none; width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: var(--lila-100); color: var(--morado-700); }
  .datos__peq { color: var(--texto-suave); font-size: .95rem; }
  .formulario { background: var(--lila-100); border-radius: var(--radio-lg); padding: clamp(1.25rem, 3vw, 2rem); }
</style>
