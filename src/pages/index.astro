---
import Img from '../components/Img.astro';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Newsletter from '../components/Newsletter.astro';
import Resenas from '../components/Resenas.astro';
import Spotify from '../components/Spotify.astro';
import { pagina, ajustes } from '../lib/datos.js';
const p = pagina('inicio');

// Datos estructurados: solo lo que se ve en la web.
const web = new URL('/', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: ajustes.nombre,
  description: p.descripcion_seo || ajustes.descripcion,
  url: web,
  logo: new URL(ajustes.logo, Astro.site).href,
  image: new URL(ajustes.logo, Astro.site).href,
  email: ajustes.email,
  ...(ajustes.telefono && { telephone: `+34${ajustes.telefono.replace(/\s/g, '')}` }),
  areaServed: [{ '@type': 'Country', name: 'España' }, { '@type': 'AdministrativeArea', name: 'Bizkaia' }],
  availableLanguage: 'es',
  ...(ajustes.instagram_url && { sameAs: [ajustes.instagram_url] }),
};
---
<Base titulo={p.hero.titulo} descripcion={p.descripcion_seo || p.hero.texto} jsonLd={jsonLd}>
  <section class="hero">
    <div class="contenedor dos-col">
      <div>
        <Img class="hero__logo" src={ajustes.logo} alt={ajustes.nombre} sizes="120px" loading="eager" />
        <h1>{p.hero.titulo}</h1>
        <p class="hero__texto">{p.hero.texto}</p>
        <a class="boton" href="/servicios/psicoterapia">{p.hero.boton}<span class="sr-only"> sobre la psicoterapia</span> <Icono nombre="flecha" size={18} /></a>
      </div>
      <Img class="foto hero__foto" src={p.hero.imagen} alt="" sizes="(max-width: 820px) calc(100vw - 2.5rem), 540px" prioridad />
    </div>
  </section>

  <section class="valores" aria-label="Cómo trabajo">
    <ul class="contenedor valores__lista">
      {p.valores.map((v) => (
        <li><span class="valores__ic"><Icono nombre={v.icono} size={28} /></span>{v.texto}</li>
      ))}
    </ul>
  </section>

  <section class="seccion seccion--lila" id="newsletter">
    <div class="contenedor estrecho newsletter">
      <Img src={p.newsletter.imagen} alt="" sizes="140px" />
      <h2>{p.newsletter.titulo}</h2>
      <p>{p.newsletter.texto}</p>
      <Newsletter boton={p.newsletter.boton} exito={p.newsletter.mensaje_exito} />
    </div>
  </section>

  <section class="seccion" id="podcast">
    <div class="contenedor dos-col">
      <Img class="foto podcast__img" src={p.podcast.imagen} alt="" sizes="(max-width: 460px) calc(100vw - 2.5rem), 420px" />
      <div>
        <h2>{p.podcast.titulo}</h2>
        <p>{p.podcast.texto}</p>
        <div class="podcast__episodios">
          {p.podcast.episodios.map((e) => (
            <Spotify url={e.url} titulo={e.titulo} subtitulo={e.subtitulo} duracion={e.duracion} portada={p.podcast.imagen} programa={p.podcast.titulo} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="seccion seccion--lila" id="resenas">
    <div class="contenedor">
      <div class="resenas__cabecera">
        <Img src={p.resenas.imagen} alt="" sizes="220px" />
        <div>
          <h2>{p.resenas.titulo}</h2>
          <p>{p.resenas.texto}</p>
        </div>
      </div>
      <Resenas />
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor contacto-rapido">
      <h2>¿Hablamos?</h2>
      <p>Escríbeme a <a href={`mailto:${ajustes.email}`}>{ajustes.email}</a>{ajustes.telefono && <> o llámame al <a href={`tel:${ajustes.telefono.replace(/\s/g, '')}`}>{ajustes.telefono}</a></>}.</p>
      <div class="contacto-rapido__acciones">
        <a class="boton" href="/contacto">Ir a contacto</a>
        {ajustes.instagram_url && <a class="boton boton--borde" href={ajustes.instagram_url} target="_blank" rel="noopener"><Icono nombre="instagram" size={18} /> {ajustes.instagram_usuario}</a>}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(2rem, 6vw, 4.5rem); background: radial-gradient(ellipse at 90% 10%, var(--lila-100), transparent 60%); }
  .hero__logo { width: 120px; height: 120px; object-fit: contain; margin-bottom: 1rem; }
  .hero__texto { font-size: 1.2rem; color: var(--texto-suave); margin-bottom: 1.75rem; }
  .hero__foto { aspect-ratio: 4 / 3; }

  .valores { background: var(--morado-800); color: #fff; padding-block: 2rem; }
  .valores__lista { list-style: none; padding: 0; margin-block: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .valores__lista li { display: flex; align-items: center; gap: .9rem; font-weight: 700; line-height: 1.35; }
  .valores__ic { flex: none; width: 54px; height: 54px; border-radius: 50%; display: grid; place-items: center; background: rgba(255,255,255,.12); color: var(--lila-200); }
  @media (max-width: 900px) { .valores__lista { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .valores__lista { grid-template-columns: 1fr; } }

  .podcast__img { max-width: 420px; margin-inline: auto; }
  .podcast__episodios { display: grid; gap: .75rem; margin-top: 1.5rem; }

  .resenas__cabecera { display: flex; align-items: center; gap: 2rem; }
  .resenas__cabecera img { width: 220px; flex: none; mix-blend-mode: multiply; }
  @media (max-width: 640px) { .resenas__cabecera { flex-direction: column; align-items: flex-start; gap: 1rem; } .resenas__cabecera img { width: 170px; } }

  .newsletter { text-align: center; }
  .newsletter img { width: 140px; margin: 0 auto 1rem; }
  .contacto-rapido { text-align: center; }
  .contacto-rapido__acciones { display: flex; flex-wrap: wrap; gap: .75rem; justify-content: center; margin-top: 1.25rem; }
</style>
