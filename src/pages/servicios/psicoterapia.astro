---
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import Modalidad from '../../components/Modalidad.astro';
import SesionInformativa from '../../components/SesionInformativa.astro';
import { pagina } from '../../lib/datos.js';
const p = pagina('psicoterapia');
---
<Base titulo={p.titulo}>
  <section class="cabecera-pagina">
    <div class="contenedor estrecho">
      <p class="mano etiqueta">Servicios</p>
      <h1>{p.titulo}</h1>
      <p class="intro">{p.intro}</p>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <details class="pistas">
        <summary><span>{p.pistas.boton}</span><Icono nombre="abajo" /></summary>
        <div class="pistas__cuerpo dos-col">
          <img class="foto" src={p.pistas.imagen} alt="" loading="lazy" width="700" height="700" />
          <div>
            <h2>{p.pistas.titulo}</h2>
            <ul class="pistas__lista">{p.pistas.lista.map((t) => <li>{t}</li>)}</ul>
          </div>
        </div>
      </details>

      <div class="ofrezco">
        <h2 class="ofrezco__titulo">{p.ofrezco.titulo}</h2>
        <ol class="ofrezco__lista">
          {p.ofrezco.lista.map((t) => <li>{t}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="seccion seccion--lila">
    <div class="contenedor dos-col">
      <Modalidad {...p.modalidad} />
      <img class="ilustracion" src={p.modalidad.imagen} alt="" loading="lazy" width="600" height="320" />
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor esquema-cont">
      <h2>{p.esquema.titulo}</h2>
      <ol class="cuaderno esquema">
        {p.esquema.pasos.map((paso) => (
          <li><Icono nombre={paso.icono} size={22} /><span>{paso.texto}</span></li>
        ))}
      </ol>
      <p class="esquema__nota">{p.esquema.nota}</p>
      <SesionInformativa {...p.sesion_informativa} cta={p.cta} />
    </div>
  </section>
</Base>

<style>
  .etiqueta { font-size: 1.6rem; margin: 0; }
  .intro { font-size: 1.2rem; color: var(--texto-suave); }

  .pistas { border-radius: var(--radio-lg); background: var(--superficie); border: 1px solid var(--borde); box-shadow: var(--sombra); }
  .pistas summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.25rem 1.5rem; font-weight: 700; font-size: 1.15rem; color: var(--verde-800); background: var(--verde-50); border-radius: var(--radio-lg); }
  .pistas summary::-webkit-details-marker { display: none; }
  .pistas summary :global(.icono) { transition: transform .2s; flex: none; }
  .pistas[open] summary { border-radius: var(--radio-lg) var(--radio-lg) 0 0; }
  .pistas[open] summary :global(.icono) { transform: rotate(180deg); }
  .pistas__cuerpo { padding: 2rem 1.5rem; align-items: start; }
  .pistas__cuerpo h2 { font-size: 1.4rem; }
  .pistas__lista { padding-left: 1.2rem; display: grid; gap: .5rem; }
  .pistas__lista li::marker { color: var(--morado-500); }

  .ofrezco { margin-top: clamp(3rem, 7vw, 5rem); text-align: center; }
  .ofrezco__titulo {
    font-family: var(--f-mano); font-size: clamp(2.3rem, 5vw, 3.4rem); color: var(--morado-700);
    display: inline-block; background: linear-gradient(transparent 62%, var(--lila-200) 62%); padding-inline: .4rem;
  }
  .ofrezco__lista { list-style: none; counter-reset: o; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; text-align: left; }
  .ofrezco__lista li { counter-increment: o; background: var(--lila-100); border-radius: var(--radio-lg); padding: 1.5rem; position: relative; padding-top: 3.6rem; }
  .ofrezco__lista li::before { content: counter(o); position: absolute; top: 1rem; left: 1.5rem; width: 2.2rem; height: 2.2rem; border-radius: 50%; background: var(--morado-700); color: #fff; display: grid; place-items: center; font-weight: 700; }
  @media (max-width: 760px) { .ofrezco__lista { grid-template-columns: 1fr; } }

  .esquema-cont { max-width: 820px; }
  .esquema { list-style: none; margin: 1.5rem 0 0; }
  .esquema li { display: flex; gap: .8rem; align-items: flex-start; min-height: 2rem; }
  .esquema li + li { margin-top: 0; }
  .esquema :global(.icono) { flex: none; color: var(--morado-500); margin-top: .3rem; }
  .esquema__nota { margin-top: 1.5rem; font-style: italic; color: var(--texto-suave); }
</style>
