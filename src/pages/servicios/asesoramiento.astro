---
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import { pagina, md } from '../../lib/datos.js';
const p = pagina('asesoramiento');
---
<Base titulo={p.titulo}>
  <section class="fondo" style={`--imagen: url('${p.imagen_fondo}')`}>
    <div class="contenedor">
      <div class="fondo__texto">
        <p class="mano etiqueta">Servicios</p>
        <h1>{p.titulo}</h1>
        <p class="fondo__sub">{p.subtitulo}</p>
        <div class="prosa" set:html={md(p.cuerpo)} />
        <a class="boton" href="/contacto">{p.cta} <Icono nombre="flecha" size={18} /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* La foto ocupa toda la sección; el texto va a la izquierda para no tapar el poste. */
  .fondo {
    min-height: min(calc(100vh - 76px), 860px); display: flex; align-items: center; padding-block: 4rem;
    background: linear-gradient(90deg, rgba(36, 16, 70, .82) 0%, rgba(36, 16, 70, .55) 45%, rgba(36, 16, 70, 0) 70%), var(--imagen) center right / cover no-repeat;
    color: #fff;
  }
  .fondo__texto { max-width: 34rem; }
  .fondo h1, .fondo :global(strong) { color: #fff; }
  .etiqueta { font-size: 1.6rem; margin: 0; color: var(--verde-200); }
  .fondo__sub { font-size: 1.35rem; font-weight: 700; }
  .fondo .prosa { margin-bottom: 2rem; }
  .fondo .boton { background: #fff; color: var(--morado-800); }
  .fondo .boton:hover { background: var(--lila-100); }
  @media (max-width: 760px) {
    .fondo { background: linear-gradient(180deg, rgba(36, 16, 70, .8), rgba(36, 16, 70, .7)), var(--imagen) 70% center / cover no-repeat; }
  }
</style>
